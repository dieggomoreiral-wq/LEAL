---
// Barra do topo (copy v5): marca à esquerda, rede à direita, sem botão.
// Fixa a partir de 900 px, com fundo sólido levemente transparente: sem
// backdrop-filter, que obriga a recompor a área inteira a cada quadro.
import { contato } from '../data/contato';
import LogoLeal from './LogoLeal.astro';
---
<header class="topo" data-topo>
  <div class="wrap topo-in">
    <p class="marca"><LogoLeal class="logo" /></p>
    <p class="rede">{contato.rede}</p>
  </div>
</header>

<style>
  .topo {
    position: relative;
    background: var(--papel);
    border-bottom: 1px solid var(--linha);
    z-index: 20;
  }
  .topo-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding-block: 8px;
  }
  .marca {
    flex: none;
    line-height: 0;
  }
  .marca :global(.logo) {
    display: block;
    height: 32px;
    width: auto;
  }
  .rede {
    max-width: 15ch;
    text-align: right;
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--tinta-2);
  }
  @media (min-width: 600px) {
    .rede {
      max-width: none;
    }
  }
  @media (min-width: 900px) {
    .topo {
      position: sticky;
      top: 0;
      background: rgb(250 247 242 / 0.96);
    }
    .topo::after {
      content: '';
      position: absolute;
      inset: 100% 0 auto 0;
      height: 22px;
      background: linear-gradient(rgb(30 43 47 / 0.08), rgb(30 43 47 / 0));
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s var(--curva-saida);
    }
    .topo:global(.rolado)::after {
      opacity: 1;
    }
    .topo-in {
      min-height: 68px;
    }
    .marca :global(.logo) {
      height: 36px;
    }
    .rede {
      font-size: var(--t-sm);
    }
  }
</style>
