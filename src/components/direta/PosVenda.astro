---
// v2, bloco 3 (o coração da página). As seis perguntas de pós-venda numa
// folha pautada: confirmada (fato, quem responde, data) ou carimbo
// "pergunte na conversa". Versão compacta, uma folha só: enquanto 4 ou
// mais itens estiverem na proposta, a seção horizontal fixa cansaria.
import { dataBR, pilula, preencher } from '../../lib/direta';
import { ITENS_POS_VENDA } from '../../data/nichos/tipos-direta';
import type { AparelhoDireto, ComumDireta, CondicoesRede, VersaoDireta } from '../../data/nichos/tipos-direta';

interface Props {
  v: VersaoDireta;
  ap: AparelhoDireto;
  c: CondicoesRede;
  comum: ComumDireta;
}
const { v, ap, c, comum } = Astro.props;
const p = (t: string) => preencher(t, v, c);
const itens = ITENS_POS_VENDA.map((id, i) => ({ id, n: String(i + 1).padStart(2, '0'), t: comum.posVenda[id], f: ap.posVenda[id] }));
---
<section class="secao posvenda" id="pos-venda" aria-labelledby="t-pos">
  <div class="wrap pos-grid">
    <header class="pos-cabeca">
      <h2 data-revelar="linhas" id="t-pos">{v.posVenda.titulo}</h2>
      <p class="pos-abertura" data-revelar="subir" set:html={p(v.posVenda.abertura)} />
      <p class="pos-compromisso" data-revelar="subir">
        <Fragment set:html={p(comum.compromisso)} />
      </p>
      <a class="pos-cta" href="#pedido" data-porta="pos-venda">{comum.ctaPosVenda}<span aria-hidden="true">↓</span></a>
    </header>

    <div class="folha">
      <div class="folha-topo">
        <span>Pós-venda · {ap.nome}</span>
        <span>Para perguntar antes de fechar</span>
      </div>
      <ol class="folha-itens" role="list" data-revelar="subir" data-revelar-filhos>
        {itens.map((x) => (
          <li class:list={['item', `item-${x.f.estado}`]}>
            <span class="item-n" aria-hidden="true">{x.n}</span>
            <div class="item-q">
              <h3 set:html={p(x.t.rotulo)} />
              <p set:html={p(x.t.pergunta)} />
            </div>
            <div class="item-r">
              {x.f.estado === 'confirmado' ? (
                <>
                  <p class="r-texto" set:html={p(x.f.valor.texto)} />
                  <p class="r-meta">
                    <span class="r-quem">{x.f.valor.responsavel}</span>
                    <span>confirmado por {x.f.fonte} em {dataBR(x.f.em)}</span>
                  </p>
                </>
              ) : x.f.estado === 'na-proposta' ? (
                <span class="carimbo">{comum.carimbo}</span>
              ) : (
                <Fragment set:html={pilula(x.f)} />
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .posvenda {
    position: relative;
  }
  .pos-grid {
    display: grid;
    gap: var(--esp-int);
  }
  .pos-cabeca h2 {
    font-size: var(--t3);
    font-weight: 680;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 20ch;
  }
  .pos-abertura {
    margin-top: 0.9em;
    color: var(--tinta-2);
    max-width: 52ch;
  }
  .pos-compromisso {
    margin-top: 1em;
    padding-left: 14px;
    border-left: 3px solid var(--petroleo);
    font-weight: 600;
    color: var(--tinta);
    max-width: 52ch;
  }
  .pos-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    margin-top: 1.1em;
    font-weight: 650;
    color: var(--cta);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 8px) / 100% 1.5px no-repeat;
  }
  .pos-cta span {
    transition: translate 0.4s var(--curva);
  }
  @media (hover: hover) {
    .pos-cta:hover span {
      translate: 0 3px;
    }
  }

  /* ---------- A folha ---------- */
  .folha {
    position: relative;
    background-color: var(--folha);
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgb(15 95 102 / 0.07) 31px 32px);
    border: 1px solid var(--linha);
    border-radius: var(--r-medio);
    box-shadow: 0 1px 2px rgb(30 43 47 / 0.05), 0 30px 60px -40px rgb(15 95 102 / 0.5);
    padding: 0 16px 8px;
  }
  .folha::before {
    /* margem vermelha de caderno, discreta */
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 46px;
    width: 1px;
    background: rgb(184 72 31 / 0.22);
  }
  .folha-topo {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 14px 0 12px 42px;
    border-bottom: 1.5px solid var(--tinta);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta);
  }
  .folha-topo span:last-child {
    color: var(--tinta-2);
    font-weight: 500;
  }
  .folha-itens {
    list-style: none;
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 10px;
    padding: 18px 0;
    border-bottom: 1px solid var(--linha);
  }
  .item:last-child {
    border-bottom: 0;
  }
  .item-n {
    font-size: var(--t-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--petroleo);
    padding-top: 2px;
  }
  .item-q h3 {
    font-size: var(--t1);
    font-weight: 650;
    line-height: 1.25;
  }
  .item-q p {
    margin-top: 4px;
    font-size: var(--t-sm);
    color: var(--tinta-2);
    line-height: 1.45;
  }
  .item-r {
    grid-column: 2;
  }
  .r-texto {
    font-weight: 600;
    color: var(--tinta);
  }
  .r-meta {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: center;
    font-size: var(--t-xs);
    color: var(--tinta-2);
  }
  .r-quem {
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--petroleo);
    color: #fff;
    font-weight: 600;
  }
  .item-confirmado .item-n {
    color: #fff;
    background: var(--petroleo);
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    font-size: var(--t-xs);
  }
  .carimbo {
    display: inline-block;
    padding: 6px 12px 5px;
    border: 2px solid currentColor;
    border-radius: 6px;
    color: var(--cta);
    font-size: var(--t-xs);
    font-weight: 700;
    font-stretch: 90%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    rotate: -2.5deg;
    mix-blend-mode: multiply;
    background: rgb(184 72 31 / 0.04);
  }

  @media (min-width: 900px) {
    .pos-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 5vw, 96px);
      align-items: start;
    }
    .pos-cabeca {
      position: sticky;
      top: calc(var(--topo) + 40px);
    }
    .folha {
      padding: 0 28px 12px;
    }
    .folha::before {
      left: 70px;
    }
    .folha-topo {
      padding-left: 56px;
    }
    .item {
      grid-template-columns: 44px minmax(0, 1fr) minmax(0, 0.85fr);
      column-gap: 20px;
      align-items: center;
      padding: 22px 0;
    }
    .item-r {
      grid-column: 3;
      justify-self: end;
      text-align: right;
    }
    .item-confirmado .item-r {
      justify-self: stretch;
      text-align: left;
    }
  }

  /* Carimbo entra com uma batida curta quando o item aparece. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.movimento) .item:not(:global(.visto)) .carimbo {
      opacity: 0;
      scale: 1.5;
    }
    :global(.movimento) .item:global(.visto) .carimbo {
      transition: opacity 0.25s var(--curva-saida) 0.35s, scale 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) 0.35s;
    }
  }
</style>
