---
// 5. Antes de comprar, confira. Acordeão com uma pergunta aberta por vez
// (details[name], reforçado em interacoes.ts pela classe .faq). Abre ao
// carregar a pergunta marcada com aberta. Sem foto e sem botão.
import { marca } from '../../lib/rico';
import type { Nicho } from '../../data/nichos/tipos';

interface Props {
  n: Nicho;
}
const c = Astro.props.n.confira;
---
<section class="secao confira" id="confira" aria-labelledby="t-confira">
  <div class="wrap">
    <h2 data-revelar="linhas" id="t-confira">{c.titulo}</h2>
    <div class="faq" data-revelar="subir" data-revelar-filhos>
      {c.perguntas.map((p) => (
        <details name="confira" open={p.aberta}>
          <summary><h3>{p.pergunta}</h3><span class="chevron" aria-hidden="true"></span></summary>
          <div class="abre" set:html={marca(p.resposta)} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .confira {
    background: var(--papel-2);
  }
  .faq {
    margin-top: var(--esp-int);
    max-width: 820px;
    border-top: 1px solid var(--linha-forte);
  }
  .faq details {
    border-bottom: 1px solid var(--linha-forte);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding-block: 16px;
    cursor: pointer;
    list-style: none;
    color: var(--tinta);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary h3 {
    font-size: var(--t1);
    font-weight: 600;
    font-stretch: 102%;
    transition: color 0.3s var(--curva-saida), translate 0.5s var(--curva);
  }
  .faq summary .chevron {
    color: var(--petroleo);
  }
  .faq details[open] summary h3 {
    color: var(--petroleo);
  }
  @media (hover: hover) {
    .faq summary:hover h3 {
      color: var(--petroleo);
      translate: 4px 0;
    }
  }
  .faq .abre {
    padding-bottom: 22px;
    max-width: 66ch;
    display: grid;
    gap: 0.8em;
    color: var(--tinta-2);
  }
  .faq .abre ul {
    list-style: none;
    display: grid;
    gap: 0.5em;
  }
  .faq .abre li {
    position: relative;
    padding-left: 1.4em;
  }
  .faq .abre li::before {
    content: '';
    position: absolute;
    left: 0.2em;
    top: 0.62em;
    width: 0.45em;
    height: 0.45em;
    border-radius: 2px;
    background: var(--petroleo);
    opacity: 0.75;
  }
</style>
