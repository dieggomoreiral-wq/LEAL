---
// 1. Hero de uma LP de equipamento. Os aparelhos em primeiro plano, só com o
// nome embaixo. A entrada das fotos e dos textos de apoio é CSS (começa na
// primeira pintura); o h1 entra linha a linha pelo SplitText.
import Pedestal from './Pedestal.astro';
import { marca } from '../../lib/rico';
import { contato, linkWhats } from '../../data/contato';
import type { Nicho } from '../../data/nichos/tipos';

interface Props {
  n: Nicho;
}
const { n } = Astro.props;
const h = n.hero;
const tamanho = '(min-width: 900px) min(29vw, 352px), (min-width: 48rem) calc(55vw - 46px), calc(55vw - 28px)';
---
<section class="hero" id="hero" aria-labelledby="h1">
  <div class="wrap hero-grid">
    <div class="hero-produtos" style={`--n:${h.pedestais.length}`}>
      {h.pedestais.map((p) => (
        <figure class="pedestal">
          <div class="pedestal-foto">
            <span class="sombra" aria-hidden="true"></span>
            <Pedestal p={p} sizes={tamanho} larguras={[320, 480, 640, 800, 960]} prioridade="alta" />
          </div>
          <figcaption class="pedestal-nome">{p.nome}</figcaption>
        </figure>
      ))}
      {h.pendencia && <p class="hero-pend"><span class="pend">{h.pendencia}</span></p>}
    </div>

    <div class="hero-texto">
      <p class="sobre">{h.sobre}</p>
      <h1 id="h1" data-revelar="linhas" data-abertura>{h.h1}</h1>
      <p class="hero-sub" set:html={marca(h.sub)} />
      <a class="botao botao-cta" id="cta-hero" data-magnetico="0.25" href={linkWhats(n.mensagemPrincipal)} target="_blank" rel="noopener">{h.botao}</a>
      <p class="hero-apoio">
        <Fragment set:html={marca(h.apoio)} />
        <a class="hero-politica" href="/privacidade">Política de privacidade</a>
      </p>
      <p class="hero-confianca">{contato.marca} · {contato.rede}</p>
      <p class="hero-filtro">{h.filtro}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 20px var(--esp);
    overflow: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .hero-produtos {
    display: grid;
    grid-template-columns: repeat(var(--n, 2), minmax(0, 1fr));
    gap: 12px;
  }
  .pedestal {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .pedestal-foto {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--folha);
    border: 1px solid var(--linha);
    border-radius: var(--r-grande);
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(30 43 47 / 0.04), 0 24px 44px -32px rgb(15 95 102 / 0.45);
  }
  .sombra {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 6%;
    height: 5.5%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(30 43 47 / 0.22), rgb(30 43 47 / 0));
    z-index: 0;
    pointer-events: none;
  }
  .pedestal-nome {
    padding-inline: 4px;
    font-weight: 650;
    font-stretch: 106%;
    color: var(--petroleo);
    font-size: var(--t0);
    line-height: 1.25;
    text-align: center;
  }
  .hero-pend {
    grid-column: 1 / -1;
    font-size: var(--t-sm);
    line-height: 1.3;
  }

  .hero-texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .sobre {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--petroleo);
    margin-bottom: 0.7em;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .sobre::before {
    content: '';
    width: 1.6em;
    height: 1.5px;
    background: currentColor;
    opacity: 0.6;
  }
  h1 {
    font-size: var(--t4);
    font-weight: 680;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--tinta);
    text-wrap: balance;
    max-width: 18ch;
  }
  .hero-sub {
    margin-top: 0.9em;
    font-size: var(--t1);
    color: var(--tinta-2);
    line-height: 1.5;
    max-width: 44ch;
  }
  .hero-texto .botao {
    margin-top: 1.4em;
    width: 100%;
    min-height: 54px;
    font-size: 1.0625rem;
  }
  .hero-apoio {
    margin-top: 0.9em;
    font-size: var(--t-sm);
    color: var(--tinta);
    max-width: 46ch;
    line-height: 1.75;
  }
  .hero-politica {
    display: block;
    width: max-content;
    margin-top: 0.2em;
    font-size: var(--t-xs);
    color: var(--tinta-2);
  }
  .hero-confianca {
    margin-top: 1.2em;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--petroleo);
  }
  .hero-filtro {
    margin-top: 0.8em;
    padding-top: 0.8em;
    border-top: 1px solid var(--linha);
    font-size: var(--t-xs);
    color: var(--tinta-2);
    max-width: 46ch;
    width: 100%;
  }
  @media (min-width: 600px) {
    .hero-texto .botao {
      width: auto;
    }
  }
  @media (min-width: 48rem) {
    .hero-produtos {
      gap: 20px;
    }
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: clamp(40px, 5vw, 72px);
      min-height: calc(100svh - var(--topo));
      display: flex;
      align-items: center;
    }
    .hero > .wrap {
      width: 100%;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(32px, 5vw, 80px);
      align-items: center;
    }
    h1 {
      font-stretch: 104%;
      line-height: 1.02;
      max-width: 16ch;
    }
  }

  /* ---------- Entrada (só com movimento permitido) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.movimento) .pedestal-foto {
      animation: surge 0.45s var(--curva-saida) backwards;
    }
    :global(.movimento) .pedestal-foto::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 4;
      background: var(--papel);
      transform-origin: 50% 0%;
      transform: scaleY(0);
      animation: cortina var(--d-cortina) var(--curva-cortina) backwards;
    }
    :global(.movimento) .pedestal-foto :global(.produto) {
      animation: produto 1.1s var(--curva) 0.35s backwards;
    }
    :global(.movimento) .sombra {
      animation: sombra 1.1s var(--curva) 0.45s backwards;
    }
    :global(.movimento) .pedestal-nome,
    :global(.movimento) .hero-pend {
      animation: sobe 0.9s var(--curva) 0.9s backwards;
    }
    :global(.movimento) .pedestal + .pedestal .pedestal-foto,
    :global(.movimento) .pedestal + .pedestal .pedestal-foto::after {
      animation-delay: 0.12s;
    }
    :global(.movimento) .pedestal + .pedestal .pedestal-foto :global(.produto) {
      animation-delay: 0.47s;
    }
    :global(.movimento) .pedestal + .pedestal .sombra {
      animation-delay: 0.57s;
    }
    :global(.movimento) .pedestal + .pedestal .pedestal-nome {
      animation-delay: 0.98s;
    }
    :global(.movimento) .hero-texto > :not(h1) {
      animation: sobe var(--d-revelar) var(--curva) backwards;
    }
    :global(.movimento) .hero-texto > :nth-child(1) { animation-delay: 0.5s; }
    :global(.movimento) .hero-texto > :nth-child(3) { animation-delay: 0.68s; }
    :global(.movimento) .hero-texto > :nth-child(4) { animation-delay: 0.76s; }
    :global(.movimento) .hero-texto > :nth-child(5) { animation-delay: 0.84s; }
    :global(.movimento) .hero-texto > :nth-child(6) { animation-delay: 0.9s; }
    :global(.movimento) .hero-texto > :nth-child(7) { animation-delay: 0.96s; }
    @media (min-width: 48rem) {
      :global(.movimento) .pedestal-foto :global(.produto),
      :global(.movimento) .sombra {
        animation-duration: 1.5s;
      }
    }
  }
  @keyframes surge {
    from { opacity: 0; }
  }
  @keyframes cortina {
    from { transform: scaleY(1); }
  }
  @keyframes produto {
    from { opacity: 0; transform: translate3d(0, -9%, 0) scale(1.06); }
  }
  @keyframes sombra {
    from { opacity: 0; transform: scaleX(0.35); }
  }
  @keyframes sobe {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
  }
</style>
