---
// Rodapé (copy v5). "usadas com autorização" só vai ao ar com a autorização
// em mãos (trava 3 do guardião): até lá, pílula.
import { contato } from '../data/contato';
import { marca } from '../lib/rico';

interface Props {
  /** Marcas, imagens e vídeos de cada LP. */
  marcas: string;
  /** Linha de uso profissional, se diferente da padrão. */
  uso?: string;
  politicas?: { privacidade: string; cookies: string };
}
const {
  marcas,
  politicas,
  uso = 'Equipamentos destinados a uso profissional. O uso segue o registro de cada aparelho na Anvisa, o manual do fabricante e as regras do conselho de quem opera.',
} = Astro.props;
---
<footer class="rodape" id="rodape">
  <div class="wrap">
    <p>{contato.razaoSocial} · {contato.marca} · CNPJ {contato.cnpj} · {contato.cidade}</p>
    <p><strong>{contato.rede}.</strong></p>
    <p class="texto">{uso}</p>
    <p class="texto" set:html={marca(marcas)} />
    <p class="rodape-links"><a href={politicas?.privacidade ?? '#'}>Política de privacidade</a> · <a href={politicas?.cookies ?? '#'}>Aviso de cookies</a></p>
  </div>
</footer>

<style>
  .rodape {
    position: relative;
    overflow: clip;
    padding-block: 40px calc(40px + env(safe-area-inset-bottom));
    background: var(--escuro);
    font-size: var(--t-xs);
    color: #b9c3c1;
    line-height: 1.6;
  }
  .rodape p + p {
    margin-top: 0.8em;
  }
  .rodape strong {
    color: #f4f1eb;
  }
  .rodape-links a {
    color: #f4f1eb;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    padding-bottom: 1px;
  }
  .rodape-links a:hover {
    background-size: 100% 2px;
  }
  .rodape :focus-visible {
    outline-color: var(--pend);
  }
  @media (min-width: 48rem) {
    .rodape {
      padding-block: 56px;
    }
  }
</style>
