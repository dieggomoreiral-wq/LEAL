---
// Giro de 360° do Hakon: quatro quadros empilhados, todos carregados e
// decodificados antes de girar (img.decode() em interacoes.ts). O giro só
// troca a opacidade de camadas já compostas; o src nunca muda na rolagem.
// Rolagem, arraste, toque e setas do teclado.
import Foto from '../Foto.astro';
import { giroHakon } from '../../data/fotos';

interface Props {
  sizes: string;
}
const { sizes } = Astro.props;
const larguras = [240, 320, 400, 560, 720, 800];
---
<div
  class="produto giro"
  data-giro
  tabindex="0"
  role="slider"
  aria-label="Girar o Hakon 4D Premium"
  aria-valuemin="0"
  aria-valuemax="270"
  aria-valuenow="0"
  aria-valuetext="0 graus"
>
  {giroHakon.map((src, i) => (
    <Foto
      src={src}
      alt={i === 0 ? 'Hakon 4D Premium inteiro, visto de frente' : ''}
      larguras={larguras}
      sizes={sizes}
      prioridade={i === 0 ? 'alta' : 'baixa'}
      class={i === 0 ? 'quadro ativo' : 'quadro'}
      arrastavel={false}
    />
  ))}
  <svg class="giro-guia" viewBox="0 0 120 24" aria-hidden="true">
    <ellipse cx="60" cy="10" rx="52" ry="8" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="2 3"></ellipse>
    <path d="M104 15.5l4.2-1.6-1.2 4.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
    <path d="M16 4.5l-4.2 1.6 1.2-4.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
  </svg>
</div>

<style>
  .giro {
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    border-radius: var(--r-grande);
  }
  .giro:global(.arrastando) {
    cursor: grabbing;
  }
  .giro :global(.quadro) {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.16s var(--ease);
    -webkit-user-drag: none;
    pointer-events: none;
  }
  .giro :global(.quadro.ativo) {
    opacity: 1;
  }
  /* Enquanto a abertura gira ou a rolagem dirige o giro, as quatro camadas
     ficam compostas (will-change só nesse intervalo). */
  .giro:global(.girando) :global(.quadro) {
    will-change: opacity;
  }
  .giro-guia {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 3.2%;
    z-index: 2;
    width: 76%;
    height: auto;
    color: var(--petroleo);
    opacity: 0.55;
    transition: opacity 0.2s var(--ease);
  }
  .giro:hover .giro-guia,
  .giro:focus-visible .giro-guia {
    opacity: 0.9;
  }
  .giro:focus-visible {
    outline-offset: -4px;
  }
</style>
