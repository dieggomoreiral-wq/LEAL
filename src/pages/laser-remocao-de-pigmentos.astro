import { pigmentos } from '../data/nichos/pigmentos';
import { pigmentosDireta } from '../data/nichos/diretas';
import { rascunho } from '../lib/direta';
---
{rascunho ? <Pagina n={pigmentos} /> : <PaginaDireta v={pigmentosDireta} />}
